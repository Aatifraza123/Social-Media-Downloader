# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/social-media-downloader?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-change-this-in-production

# Admin Account (used by createAdmin script only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Storage
STORAGE_PATH=./storage/downloads
TEMP_PATH=./storage/temp
MAX_STORAGE_GB=50
MAX_FILE_SIZE_MB=2048

# File Cleanup Configuration
FILE_RETENTION_HOURS=24
CLEANUP_SCHEDULE=0 */6 * * *

# Download Settings
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TIMEOUT_MS=600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# FFmpeg
FFMPEG_PATH=ffmpeg

# Logging
LOG_LEVEL=info
